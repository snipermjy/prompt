type DifficultyLevel = 'beginner' | 'intermediate' | 'advanced';

// ✅ 函数要有明确的类型注解
function formatPromptData(raw: any): Prompt {
  // 实现
}

async function fetchPrompts(
  category?: string,
  limit: number = 20
): Promise<Prompt[]> {
  // 实现
}

// ✅ 使用泛型
function createResponse<T>(data: T, success: boolean) {
  return { data, success };
}

// ❌ 避免使用 any（除非必要）
function badExample(data: any) {} // 不好

// ✅ 使用 unknown 或具体类型
