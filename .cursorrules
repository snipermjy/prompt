## API规范

### 路由设计

```typescript
// ✅ RESTful风格
GET    /api/prompts          // 获取列表
GET    /api/prompts/:id      // 获取详情
POST   /api/prompts          // 创建
PUT    /api/prompts/:id      // 更新
DELETE /api/prompts/:id      // 删除

// ✅ 使用 Server Actions（推荐）
'use server'

export async function getPrompts(category?: string) {
  // 实现
}

export async function createPrompt(data: CreatePromptInput) {
  // 实现
}
```

### 响应格式

```typescript
// ✅ 统一响应格式
interface ApiResponse<T> {
  success: boolean;
  data?: T;
  error?: string;
  message?: string;
}

// ✅ 成功响应
return {
  success: true,
  data: prompts,
  message: '获取成功'
};

// ✅ 错误响应
return {
  success: false,
  error: 'NOT_FOUND',
  message: '提示词不存在'
};
```

## 错误处理

### 前端错误处理

```typescript
// ✅ Try-Catch包裹
try {
  const data = await fetchPrompts();
  setPrompts(data);
} catch (error) {
  console.error('Failed to fetch prompts:', error);
  setError(error instanceof Error ? error.message : 'Unknown error');
  // 显示错误提示
  toast.error('加载失败，请重试');
}

// ✅ 边界情况处理
if (!prompt) {
  return <div>提示词不存在</div>;
}

if (prompts.length === 0) {
  return <EmptyState />;
}
```

### 后端错误处理

```typescript
// ✅ 详细的错误信息
export async function getPromptById(id: string) {
  if (!id) {
    throw new Error('Prompt ID is required');
  }
  
  const { data, error } = await supabase
    .from('prompts')
    .select('*')
    .eq('id', id)
    .single();
  
  if (error) {
    console.error('Database error:', error);
    throw new Error(`Failed to fetch prompt: ${error.message}`);
  }
  
  if (!data) {
    throw new Error('Prompt not found');
  }
  
  return data;
}
```

